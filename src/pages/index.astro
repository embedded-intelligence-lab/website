---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";

const focusAreas = [
  "Embedded ML",
  "Edge AI",
  "Federated Learning",
  "Local AI Systems",
];
---

<BaseLayout>
  <Navbar />

  <main>
    <section class="mx-auto max-w-6xl px-6 py-28">
      <p class="mb-5 text-sm uppercase tracking-[0.25em] text-zinc-500">
        Embedded Intelligence Lab
      </p>

      <h1 class="max-w-4xl text-5xl font-bold tracking-tight md:text-7xl">
        Edge AI, Embedded ML and Intelligent Systems.
      </h1>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-zinc-400">
        Building efficient AI systems for constrained and real-world
        environments.
      </p>
    </section>

    <section id="focus" class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="text-2xl font-semibold">Focus Areas</h2>

      <div class="mt-8 grid gap-4 md:grid-cols-4">
        {focusAreas.map((area) => (
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-6">
            <h3 class="font-medium">{area}</h3>
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="mx-auto max-w-6xl px-6 py-16">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-8">
        <h2 class="text-2xl font-semibold">Projects coming soon.</h2>

        <p class="mt-4 max-w-2xl text-zinc-400">
          Currently building experimental edge AI and embedded ML systems.
        </p>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="text-2xl font-semibold">Contact</h2>

      <div class="mt-6 flex flex-wrap gap-4 text-zinc-400">
        <a href="https://github.com/" class="hover:text-white">GitHub</a>
        <a href="https://linkedin.com/" class="hover:text-white">LinkedIn</a>
        <a href="mailto:hello@embeddedintelligencelab.com" class="hover:text-white">
          Mail
        </a>
      </div>
    </section>
  </main>
</BaseLayout>